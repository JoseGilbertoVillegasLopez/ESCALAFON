{% extends 'admin/layout.html.twig' %}
{% block title %}Editar Categoría{% endblock %}
{% block admin_content %}



  <div class="card p-4 shadow-sm mx-auto" >
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-pencil-square text-warning"></i> Editar Categoría</h1>
    </div>

    {{ form_start(form) }}

    <section class="mb-4">
      <h4><i class="bi bi-info-circle"></i> Información de la categoría</h4>

      <div class="info-grid">
        <div>
          {{ form_label(form.nombre, 'Nombre de la categoría', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.nombre, {'attr': {'class': 'info-input', 'placeholder': 'Ejemplo: Personal Administrativo'}}) }}
        </div>

        <div style="grid-column: span 2;">
          {{ form_label(form.descripcion, 'Descripción', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.descripcion, {'attr': {'class': 'info-input', 'rows': 4, 'placeholder': 'Actualiza la descripción si es necesario'}}) }}
        </div>
      </div>
    </section>

    <div class="d-flex justify-content-between align-items-center mt-4">
      <a href="{{ path('app_categoria_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left-circle"></i> Volver
      </a>

      <div class="d-flex gap-2">
        <button class="btn-guardar">
          <i class="bi bi-save"></i> Guardar cambios
        </button>
    {{ form_end(form) }}

        {{ include('admin/categoria/_delete_form.html.twig') }}
      </div>
    </div>

  </div>
{% endblock %}
