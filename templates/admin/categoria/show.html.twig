{% extends 'admin/layout.html.twig' %}
{% block title %}Detalle de Categoría{% endblock %}
{% block admin_content %}



  <div class="card p-4 shadow-sm mx-auto" >
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-tag-fill text-info"></i> Información de la Categoría</h1>
    </div>

    <section class="mb-4">
      <h4><i class="bi bi-info-circle"></i> Detalles generales</h4>
      <div class="info-grid">
        <div>
          <label class="data-label">Nombre</label>
          <div class="info-field">{{ categorium.nombre }}</div>
        </div>

        <div style="grid-column: span 2;">
          <label class="data-label">Descripción</label>
          <div class="info-field">
            {{ categorium.descripcion ?: 'Sin descripción disponible' }}
          </div>
        </div>
      </div>
    </section>

    <hr class="my-4">

    <div class="d-flex justify-content-between align-items-center">
      <a href="{{ path('app_categoria_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left-circle"></i> Volver
      </a>

      <div class="d-flex gap-2">
        <a href="{{ path('app_categoria_edit', {'id': categorium.id}) }}" class="btn btn-outline-warning">
          <i class="bi bi-pencil-square"></i> Editar
        </a>
        {{ include('admin/categoria/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
{% endblock %}
