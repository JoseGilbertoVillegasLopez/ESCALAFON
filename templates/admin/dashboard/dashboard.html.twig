{% extends 'base.html.twig' %}

{% block title %}Panel Admin{% endblock %}

{% block body %}
<div class="d-flex min-vh-100" style="background:#161b21;">
  {# === Sidebar === #}
  <aside class="p-4 border-end" style="width:260px;background:#1e242b;border-color:#222b34 !important;">
    <h3 class="fw-bold mb-4" style="color:#0dcaf0">Panel Admin</h3>

    <nav class="nav flex-column gap-1">
      <a href="{{ path('app_vacantes_index') }}"
         class="nav-link px-3 py-2 rounded {{ app.request.get('_route') starts with 'app_vacantes' ? 'active' : '' }}">
        Vacantes
      </a>
      <a href="{{ path('app_informacion_personal_index') }}"
         class="nav-link px-3 py-2 rounded {{ app.request.get('_route') starts with 'app_informacion_personal' ? 'active' : '' }}">
        Personal
      </a>
      <a href="{{ path('app_categoria_index') }}"
         class="nav-link px-3 py-2 rounded {{ app.request.get('_route') starts with 'app_categoria' ? 'active' : '' }}">
        Categorías
      </a>
      <a href="{{ path('app_puesto_index') }}"
         class="nav-link px-3 py-2 rounded {{ app.request.get('_route') starts with 'app_puesto' ? 'active' : '' }}">
        Puestos
      </a>
      <a href="{{ path('app_cursos_index') }}"
         class="nav-link px-3 py-2 rounded {{ app.request.get('_route') starts with 'app_cursos' ? 'active' : '' }}">
        Cursos
      </a>
      <a href="{{ path('app_historial_sanciones_index') }}"
         class="nav-link px-3 py-2 rounded {{ app.request.get('_route') starts with 'app_historial_sanciones' ? 'active' : '' }}">
        Sanciones
      </a>
      <a href="{{ path('admin_escalafon_index') }}"
         class="nav-link px-3 py-2 rounded {{ app.request.get('_route') starts with 'admin_escalafon' ? 'active' : '' }}">
        Escalafón
      </a>
      <a href="{{ path('app_historial_ascenso_index') }}"
         class="nav-link px-3 py-2 rounded {{ app.request.get('_route') starts with 'app_historial_ascenso' ? 'active' : '' }}">
        Ascensos
      </a>
    </nav>

    <style>
      .nav-link{color:#b6c0cc}
      .nav-link:hover{color:#0dcaf0;background:#1b2128}
      .nav-link.active{background:#0dcaf0;color:#000 !important;font-weight:600}
    </style>
  </aside>

  {# === Contenido === #}
  <main class="flex-grow-1 p-4">
    {% block admin_content %}
      <div class="card p-4" style="background:#1e242b;border:1px solid #222b34;color:#e9edf1">
        <h2 class="mb-2" style="color:#0dcaf0">Bienvenido</h2>
        <p>Elige una sección del menú lateral.</p>
      </div>
    {% endblock %}
  </main>
</div>
{% endblock %}
