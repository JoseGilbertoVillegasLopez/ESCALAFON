{% extends 'admin/layout.html.twig' %}
{% block title %}Detalles del Puesto{% endblock %}
{% block admin_content %}



  <div class="card p-4 shadow-sm mx-auto" >
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-briefcase-fill text-info"></i> Detalles del Puesto</h1>
      <a href="{{ path('app_puesto_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left-circle"></i> Volver a la lista
      </a>
    </div>

    <section class="mb-4">
      <div class="mb-3">
        <h5 class="data-label"><i class="bi bi-person-badge"></i> Nombre del Puesto</h5>
        <div class="info-input p-2">{{ puesto.nombre }}</div>
      </div>

      <div class="mb-3">
        <h5 class="data-label"><i class="bi bi-card-text"></i> Descripción</h5>
        <div class="info-input p-2">
          {{ puesto.descripcion ?: 'Sin descripción disponible' }}
        </div>
      </div>
    </section>

    <div class="text-end mt-4 d-flex justify-content-end gap-2">
      <a href="{{ path('app_puesto_edit', {'id': puesto.id}) }}" class="btn btn-warning d-flex align-items-center gap-2">
        <i class="bi bi-pencil-square"></i> Editar
      </a>

      {{ include('admin/puesto/_delete_form.html.twig') }}
    </div>
  </div>
{% endblock %}
