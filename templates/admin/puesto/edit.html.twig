{% extends 'base.html.twig' %}

{% block title %}Editar Puesto{% endblock %}

{% block body %}
<main class="container-fluid py-5" style="min-height: 100vh;">
  <div class="card p-4 shadow-sm mx-auto" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-pencil-square text-warning"></i> Editar Puesto</h1>
      <a href="{{ path('app_puesto_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left-circle"></i> Volver a la lista
      </a>
    </div>

    {{ form_start(form, {'attr': {'class': 'puesto-form'}}) }}
      <section class="mb-4">
        <div class="mb-3">
          {{ form_label(form.nombre, 'Nombre del Puesto', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.nombre, {'attr': {'class': 'form-control info-input', 'placeholder': 'Ejemplo: Coordinador, Auxiliar, etc.'}}) }}
        </div>

        <div class="mb-3">
          {{ form_label(form.descripcion, 'Descripción', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.descripcion, {'attr': {'class': 'form-control info-input', 'placeholder': 'Breve descripción del puesto'}}) }}
        </div>
      </section>

      <div class="text-end mt-4 d-flex justify-content-end gap-2">
        <button class="btn-guardar d-flex align-items-center gap-2">
          <i class="bi bi-save"></i> Actualizar Puesto
        </button>

        {{ include('admin/puesto/_delete_form.html.twig') }}
      </div>
    {{ form_end(form) }}
  </div>
</main>

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/admin/puesto/puesto.css') }}">
{% endblock %}
{% endblock %}
