{% extends 'admin/layout.html.twig' %}
{% block title %}Puestos{% endblock %}
{% block admin_content %}



  <div class="card p-4 shadow-sm mx-auto" >
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-person-workspace text-info"></i> Lista de Puestos</h1>
    </div>

    {# 🔍 FILTRO POR NOMBRE O DESCRIPCIÓN #}
    <form method="get" class="mb-4">
      <div class="row g-2 align-items-end">
        <div class="col-md-8">
          <label for="nombre" class="data-label">Buscar por nombre o descripción</label>
          <input type="text" name="nombre" id="nombre" value="{{ app.request.get('nombre') }}" 
                 class="form-control info-input" placeholder="Ejemplo: Coordinador, Auxiliar, etc.">
        </div>
        <div class="col-md-4 d-flex gap-2">
          <button class="btn btn-outline-info flex-fill" type="submit">
            <i class="bi bi-search"></i> Buscar
          </button>
          <a href="{{ path('app_puesto_index') }}" class="btn btn-outline-warning flex-fill">
            <i class="bi bi-arrow-clockwise"></i> Limpiar
          </a>
        </div>
      </div>
    </form>

    {# 🧾 TABLA DE PUESTOS #}
    <div class="table-responsive mt-4">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="{{ path('app_puesto_new') }}" class="btn-guardar d-flex align-items-center gap-2">
          <i class="bi bi-plus-circle"></i> Nuevo Puesto
        </a>
      </div>

      <table class="table table-dark table-striped align-middle mb-0">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th class="text-center" style="width: 150px;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for puesto in puestos %}
            <tr>
              <td>{{ puesto.nombre }}</td>
              <td>{{ puesto.descripcion ?: 'Sin descripción' }}</td>
              <td class="text-center">
                <a href="{{ path('app_puesto_show', {'id': puesto.id}) }}" 
                   class="btn btn-outline-info btn-sm" title="Ver">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('app_puesto_edit', {'id': puesto.id}) }}" 
                   class="btn btn-outline-warning btn-sm" title="Editar">
                  <i class="bi bi-pencil-square"></i>
                </a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="3" class="text-center text-muted py-3">
                <i class="bi bi-inbox"></i> No se encontraron puestos.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
