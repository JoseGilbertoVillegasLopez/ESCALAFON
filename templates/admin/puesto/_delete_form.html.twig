<form method="post" 
      action="{{ path('app_puesto_delete', {'id': puesto.id}) }}" 
      onsubmit="return confirm('¿Estás seguro de que deseas eliminar este puesto?');" 
      class="d-inline-block">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ puesto.id) }}">
  <button class="btn btn-danger d-flex align-items-center gap-2" title="Eliminar">
    <i class="bi bi-trash"></i> Eliminar
  </button>
</form>
