{{ form_start(form) }}

{# _form.html.twig #}

{# Inicia el formulario con ID para vincular el botón de submit externo #}
{{ form_start(form, {'attr': {'id': 'form_informacion_personal', 'class': 'needs-validation'}}) }}

{# =========================
   🧍 SECCIÓN 0: FOTO / IMAGEN DE PERFIL
   ========================= #}
<section class="mb-5">
  <h4 class="border-bottom pb-2 mb-3">
    <i class="bi bi-image-fill"></i> Imagen de perfil
  </h4>

  <div class="col-md-4">
  <div class="imagen">
    <div class="preview text-center">
      <img
        id="preview"
        src="{% if form.vars.value and form.vars.value.imagen %}
                {{ asset('uploads/imagenes/' ~ form.vars.value.imagen) }}
             {% else %}
                {{ asset('uploads/imagenes/login_logo.png') }}
             {% endif %}"
        alt="Imagen de perfil"
        class="img-thumbnail"
        width="180"
      >
    </div>
  </div>
</div>

    {# Columna del input de archivo #}
    <div class="col-md-8">
      <div class="ruta">
        {# Campo de subida de imagen del formulario #}
        {{ form_row(form.imagen, {
          attr: {
            accept: 'image/*',
            'data-preview-target': '#preview'   # lo usaremos luego en el JS para actualizar la vista previa
          },
        }) }}
      </div>
    </div>
  </div>
</section>

{# =========================
   🧍 SECCIÓN 1: DATOS PERSONALES
   ========================= #}
<section class="mb-5">
  <h4 class="border-bottom pb-2 mb-3">
    <i class="bi bi-person-badge"></i> Datos personales
  </h4>
  <div class="row g-3">
    <div class="col-md-4">
      {{ form_row(form.nombre) }}
    </div>
   <div class="col-md-4">
      {{ form_row(form.estadoCivil) }}
    </div>
  </div>
</section>




{# =========================
   📞 SECCIÓN 2: CONTACTO
   ========================= #}
<section class="mb-5">
  <h4 class="border-bottom pb-2 mb-3">
    <i class="bi bi-telephone-fill"></i> Contacto
  </h4>
  <div class="row g-3">
    <div class="col-md-6">
      {{ form_row(form.telefonoFijo) }}
    </div>
    <div class="col-md-6">
      {{ form_row(form.telefonoCelular) }}
    </div>
    <div class="col-md-6">
      {{ form_row(form.correo) }}
    </div>
    <div class="col-md-12">
      {{ form_row(form.domicilio) }}
    </div>
  </div>
</section>



{# =========================
   🧩 SECCIÓN 4: CAPACITACIÓN
   ========================= #}
<section class="mb-5">
  <h4 class="border-bottom pb-2 mb-3">
    <i class="bi bi-journal-text"></i> Capacitaciones
  </h4>

  <div class="collection-capacitacion"
     data-prototype="{{ form_widget(form.capacitacion.vars.prototype)|e('html_attr') }}">
    {% for item in form.capacitacion %}
        <div class="border rounded p-3 mb-2 bg-body-secondary">
            {{ form_widget(item) }}
        </div>
    {% endfor %}
</div>

</section>

{# =========================
   🚨 SECCIÓN 5: CONTACTOS DE EMERGENCIA
   ========================= #}
<section class="mb-5">
  <h4 class="border-bottom pb-2 mb-3">
    <i class="bi bi-people-fill"></i> Contactos de emergencia
  </h4>

  <div class="collection-contactos"
     data-prototype="{{ form_widget(form.contactosEmergencias.vars.prototype)|e('html_attr') }}">
    {% for item in form.contactosEmergencias %}
        <div class="border rounded p-3 mb-2 bg-body-secondary">
            {{ form_widget(item) }}
        </div>
    {% endfor %}
</div>
</section>


<div class="text-center mt-4">
    <button type="submit" class="btn-guardar">
        <i class="bi bi-save"></i> Guardar registro
    </button>
</div>
{{ form_end(form) }}