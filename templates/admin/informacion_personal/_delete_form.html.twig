<form method="post" action="{{ path('app_informacion_personal_delete', {'id': informacion_personal.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ informacion_personal.id) }}">
    <button class="btn btn-danger btn-sm">Eliminar</button>
</form>
