{% extends 'base.html.twig' %}

{% block title %}InformacionPersonal index{% endblock %}

{% block body %}
    <h1>InformacionPersonal index</h1>
    <a href="{{ path('app_informacion_personal_new') }}">Create new</a>
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Telefono Fijo</th>
                <th>Telefono Celular</th>
                <th>Correo</th>
                <th>Curp</th>
                <th>Rfc</th>
                <th>Nss</th>
                <th>Estado Civil</th>
                <th>Domicilio</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for informacion_personal in informacion_personals %}
            <tr>
                <td>{{ informacion_personal.__ToString }}</td>
                <td>{{ informacion_personal.telefonoFijo }}</td>
                <td>{{ informacion_personal.telefonoCelular }}</td>
                <td>{{ informacion_personal.correo }}</td>
                <td>{{ informacion_personal.curp }}</td>
                <td>{{ informacion_personal.rfc }}</td>
                <td>{{ informacion_personal.nss }}</td>
                <td>{{ informacion_personal.estadoCivil ? 'Casado' : 'Soltero' }}</td>
                <td>{{ informacion_personal.domicilio }}</td>
                
                <td>
                    <a href="{{ path('app_informacion_personal_show', {'id': informacion_personal.id}) }}">show</a>
                    <a href="{{ path('app_informacion_personal_edit', {'id': informacion_personal.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="14">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
