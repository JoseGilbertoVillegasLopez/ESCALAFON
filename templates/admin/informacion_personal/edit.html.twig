{% extends 'base.html.twig' %}

{% block title %}Editar información personal{% endblock %}

{% block stylesheets %}
  {# Reutilizamos los estilos de new para mantener el mismo diseño #}
  <link rel="stylesheet" href="{{ asset('css/informacionPersonal/new.css') }}">
{% endblock %}

{% block body %}
<main class="container-fluid py-4">
  <div class="container-lg">

    <div class="card border-0 shadow-lg p-4 rounded-4">

      {# 🔙 Botón Volver #}
      <div class="mb-3 d-flex gap-2">
        <a href="{{ path('app_informacion_personal_index') }}" class="btn-volver">
          <i class="bi bi-arrow-left-circle"></i> Volver
        </a>
      </div>

      <div class="card-body">
        {# Formulario de edición (idéntico al de creación, solo cambia el include) #}
        {{ include('admin/informacion_personal/_form.html.twig', { form: form, button_label: 'Guardar cambios' }) }}
      </div>

    </div>

  </div>
</main>
{% endblock %}

{% block javascripts %}
  <script src="{{ asset('js/admin/informacionPersonal/preview.js') }}"></script>
  <script src="{{ asset('js/admin/informacionPersonal/collection.js') }}"></script>
{% endblock %}
