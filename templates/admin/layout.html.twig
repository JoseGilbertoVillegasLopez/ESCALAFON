{% extends 'base.html.twig' %}




{% block body %}
<style>
  .admin-wrapper {
  display: flex;
  min-height: 100vh;
  background-color: #161b22;
}

.sidebar {
  width: 230px;
  min-height: 100vh;
  background-color: #1c2128 !important;
  border-right: 1px solid #2d333b;
  position: sticky;
  top: 0;
}

.sidebar h4 {
  color: #ffffff;
  margin-bottom: 1.5rem;
}

.nav-link {
  color: #b0b7c3 !important;
  border-radius: 6px;
  padding: 0.4rem 0.8rem;
  transition: all 0.2s ease;
}

.nav-link:hover {
  background-color: rgba(255, 255, 255, 0.05);
  color: #fff !important;
}

.nav-link.active {
  background-color: #0d6efd !important;
  color: #fff !important;
  font-weight: 600;
}

.admin-content {
  flex-grow: 1;
  background-color: #1e242b;
  color: #f1f3f5;
  overflow-y: auto;
  padding: 2rem;
}



</style>
<div class="admin-wrapper d-flex">
  <!-- 🧭 Sidebar lateral -->
  <aside class="sidebar bg-dark text-light p-4">
    <h4 class="fw-bold mb-4">Panel Admin</h4>
    <nav class="nav flex-column gap-2">
      <a href="{{ path('app_vacantes_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_vacantes' %}active{% endif %}">Vacantes</a>
      <a href="{{ path('app_informacion_personal_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_informacion_personal' %}active{% endif %}">Personal</a>
      <a href="{{ path('app_categoria_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_categoria' %}active{% endif %}">Categorías</a>
      <a href="{{ path('app_puesto_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_puesto' %}active{% endif %}">Puestos</a>
      <a href="{{ path('app_cursos_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_cursos' %}active{% endif %}">Cursos</a>
      <a href="{{ path('app_historial_sanciones_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_historial_sanciones' %}active{% endif %}">Sanciones</a>
      <a href="{{ path('admin_escalafon_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_escalafon' %}active{% endif %}">Escalafón</a>
      <a href="{{ path('app_historial_ascenso_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_historial_ascenso' %}active{% endif %}">Ascensos</a>
    </nav>
  </aside>

  <!-- 📄 Contenido principal -->
  <main class="admin-content flex-grow-1 p-4">
    {% block admin_content %}{% endblock %}
  </main>
</div>
{% endblock %}


