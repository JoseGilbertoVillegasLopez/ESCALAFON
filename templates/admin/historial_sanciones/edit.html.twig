{% extends 'base.html.twig' %}
{% block title %}Editar Sanción{% endblock %}

{% block body %}
<main class="container-fluid py-5" style="min-height: 100vh;">
  <div class="card p-4 shadow-sm mx-auto" style="max-width: 1000px;">
    
    {# 🔙 Título y botón volver #}
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="m-0">
        <i class="bi bi-pencil-square text-warning"></i> Editar sanción
      </h1>
      <a href="{{ path('app_historial_sanciones_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

      <div class="mb-3">
        {{ form_label(form.informacionPersonal) }}
        {{ form_widget(form.informacionPersonal, {'attr': {'class': 'form-select info-input'}}) }}
        {{ form_errors(form.informacionPersonal) }}
      </div>

      <div class="mb-3">
        {{ form_label(form.fecha) }}
        {{ form_widget(form.fecha, {'attr': {'class': 'form-control info-input'}}) }}
        {{ form_errors(form.fecha) }}
      </div>

      <div class="mb-3">
        {{ form_label(form.motivo) }}
        {{ form_widget(form.motivo, {'attr': {'class': 'form-control info-input', 'placeholder': 'Motivo de la sanción'}}) }}
        {{ form_errors(form.motivo) }}
      </div>

      <div class="mb-3">
        {{ form_label(form.descripcion) }}
        {{ form_widget(form.descripcion, {'attr': {'class': 'form-control info-input', 'rows': 4, 'placeholder': 'Describe la situación...'}}) }}
        {{ form_errors(form.descripcion) }}
      </div>

      <div class="mb-4">
        {{ form_label(form.comprovante) }}
        {{ form_widget(form.comprovante, {'attr': {'class': 'form-control info-input'}}) }}
        {{ form_errors(form.comprovante) }}

        {% if historial_sancione.comprovante %}
          <div class="mt-2 d-flex align-items-center justify-content-between p-2 rounded" style="background-color: #323a45;">
            <span><i class="bi bi-file-earmark-text text-info"></i> Comprobante actual:</span>
            <a href="{{ asset('uploads/sanciones/' ~ historial_sancione.comprovante) }}" 
               target="_blank" rel="noopener noreferrer"
               class="btn btn-outline-info btn-sm d-flex align-items-center gap-2">
              <i class="bi bi-box-arrow-up-right"></i> Ver comprobante
            </a>
          </div>
        {% endif %}
      </div>

     <div class="d-flex justify-content-between align-items-center mt-4">
  <button class="btn-guardar d-flex align-items-center gap-2">
    <i class="bi bi-save"></i> Guardar cambios
  </button>

  {{ include('admin/historial_sanciones/_delete_form.html.twig') }}
</div>

{{ form_end(form) }}
    </div>
</main>
{% endblock %}
