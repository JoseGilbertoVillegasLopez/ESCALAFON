{% extends 'admin/layout.html.twig' %}
{% block title %}Nueva Sanción{% endblock %}
{% block admin_content %}


  <div class="card p-4 shadow-sm mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1><i class="bi bi-plus-circle text-info"></i> Registrar nueva sanción</h1>
      <a href="{{ path('app_historial_sanciones_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

      <div class="mb-3">
        {{ form_label(form.informacionPersonal, 'Trabajador', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.informacionPersonal, {'attr': {'class': 'form-select info-input'}}) }}
        {{ form_errors(form.informacionPersonal) }}
      </div>

      <div class="mb-3">
        {{ form_label(form.fecha, 'Fecha', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.fecha, {'attr': {'class': 'form-control info-input'}}) }}
        {{ form_errors(form.fecha) }}
      </div>

      <div class="mb-3">
        {{ form_label(form.motivo, 'Motivo', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.motivo, {'attr': {'class': 'form-control info-input', 'placeholder': 'Motivo de la sanción'}}) }}
        {{ form_errors(form.motivo) }}
      </div>

      <div class="mb-3">
        {{ form_label(form.descripcion, 'Descripcion', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.descripcion, {'attr': {'class': 'form-control info-input', 'placeholder': 'Describe brevemente la situación...'}}) }}
        {{ form_errors(form.descripcion) }}
      </div>
      <div class="mb-3">
        {{ form_label(form.puntosSancion, 'Puntos de sancion', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.puntosSancion, {'attr': {'class': 'form-control info-input'}}) }}
        {{ form_errors(form.puntosSancion) }}
      </div>


      <div class="mb-4">
        {{ form_label(form.comprovante, 'Comprovante', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.comprovante, {'attr': {'class': 'form-control info-input'}}) }}
        {{ form_errors(form.comprovante) }}
      </div>

      <button style="max-width: 200px;" class="btn-guardar w-100 d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-save"></i> Guardar sanción
      </button>

    {{ form_end(form) }}
  </div>
{% endblock %}
