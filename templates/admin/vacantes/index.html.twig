{% extends 'base.html.twig' %}

{% block title %}Vacantes index{% endblock %}

{% block body %}
    <h1>Vacantes index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Puesto</th>
                <th>Categoria</th>
                <th>Antiguedad minima</th>
                <th>Requisitos</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for vacante in vacantes %}
            <tr>
                <td>{{ vacante.nombre }}</td>
                <td>{{ vacante.puesto.nombre }}</td>
                <td>{{ vacante.categoria.nombre }}</td>
                <td>{{ vacante.antiguedad }} años</td>
                <td>######</td>
                <td>
                    <a href="{{ path('app_vacantes_show', {'id': vacante.id}) }}">show</a>
                    {{ include('admin/vacantes/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_vacantes_new') }}">Create new</a>
{% endblock %}
