{% extends 'base.html.twig' %}
{% block title %}Detalle de la Vacante{% endblock %}
{% block body %}
<div class="vacante-show-container card p-4 shadow-sm mx-auto">
    <h2 class="mb-4 text-primary fw-bold">
        <i class="bi bi-briefcase-fill"></i> Información de la Vacante
    </h2>

    <div class="info-section mb-4">
        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary">Nombre de la vacante</label>
            <div class="info-box">{{ vacante.nombre }}</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary">Antigüedad requerida</label>
            <div class="info-box">{{ vacante.antiguedad }} año(s)</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary">Puesto asociado</label>
            <div class="info-box">{{ vacante.puesto ? vacante.puesto.nombre : 'No asignado' }}</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary">Categoría</label>
            <div class="info-box">{{ vacante.categoria ? vacante.categoria.nombre : 'No asignada' }}</div>
        </div>
    </div>

    <hr class="divider">

    <h4 class="mb-3 text-primary fw-bold">
        <i class="bi bi-list-check"></i> Requisitos de la Vacante
    </h4>

    <div class="requisitos-list">
        {% if vacante.requisitos is not empty %}
            {% for requisito in vacante.requisitos %}
                <div class="requisito-item d-flex align-items-center justify-content-between mb-2 p-3 rounded">
                    <span>
                        <i class="bi bi-bookmark-check text-primary"></i>
                        {{ requisito.curso ? requisito.curso.nombre : 'Curso no asignado' }}
                    </span>
                </div>
            {% endfor %}
        {% else %}
            <p class="text-muted">No se han agregado requisitos a esta vacante.</p>
        {% endif %}
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <a href="{{ path('app_vacantes_index') }}" class="btn-back">
            <i class="bi bi-arrow-left-circle"></i> Volver
        </a>

        <div class="d-flex gap-2">
            <a href="{{ path('app_vacantes_edit', {'id': vacante.id}) }}" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Editar
            </a>
            {{ include('admin/vacantes/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
