{% extends 'base.html.twig' %}

{% block title %}Detalles de la Vacante{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/admin/vacantes/vacantes.css') }}">
<style>
html, body {
  background: radial-gradient(circle at top left, #222a33, #1e242b 60%) !important;
  color: #f1f3f5 !important;
}
</style>

<main class="page-wrapper w-100 py-5">
  <div class="vacante-show-container card shadow-sm p-4 mx-auto" style="max-width: 900px;">
    <!-- 🔹 Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="text-info fw-bold mb-0">
        <i class="bi bi-briefcase-fill me-2"></i> Detalles de la Vacante
      </h2>
      <a href="{{ path('app_vacantes_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left-circle me-1"></i> Volver
      </a>
    </div>

    <hr class="mb-4" style="border-color:#3b4652;">

    <!-- 🧾 Información general -->
    <section class="mb-4">
      <h4 class="text-info mb-3"><i class="bi bi-info-circle"></i> Información general</h4>
      <div class="info-grid mb-3">
        <div>
          <span class="data-label">Nombre de la vacante</span>
          <div class="info-field">{{ vacante.nombre }}</div>
        </div>
        <div>
          <span class="data-label">Puesto asociado</span>
          <div class="info-field">{{ vacante.puesto ? vacante.puesto.nombre : '—' }}</div>
        </div>
        <div>
          <span class="data-label">Categoría</span>
          <div class="info-field">{{ vacante.categoria ? vacante.categoria.nombre : '—' }}</div>
        </div>
        <div>
          <span class="data-label">Antigüedad requerida</span>
          <div class="info-field">{{ vacante.antiguedad }} año(s)</div>
        </div>
      </div>

      <div class="info-grid">
        <div>
          <span class="data-label">Número total de vacantes</span>
          <div class="info-field">{{ vacante.numeroVacantes }}</div>
        </div>
        <div>
          <span class="data-label">Descripción</span>
          <div class="info-field">
            {{ vacante.descripcion ?: 'Sin descripción' }}
          </div>
        </div>
        <div>
          <span class="data-label">Estado</span>
          {% if vacante.activo %}
            <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle"></i> Activa</span>
          {% else %}
            <span class="badge bg-danger px-3 py-2"><i class="bi bi-x-circle"></i> Inactiva</span>
          {% endif %}
        </div>
      </div>
    </section>

    <hr class="my-4" style="border-color:#3b4652;">

    <!-- 📋 Requisitos -->
    <section>
      <h4 class="text-info fw-bold mb-3">
        <i class="bi bi-list-check me-2"></i> Requisitos de la vacante
      </h4>

      {% if vacante.requisitos|length > 0 %}
        <div class="requisitos-list d-flex flex-column gap-2">
          {% for requisito in vacante.requisitos %}
            <div class="p-3 rounded requisito-item d-flex align-items-center justify-content-between" style="background-color:#2a323c;">
              <div class="text-light">
                <i class="bi bi-bookmark-check text-info me-2"></i>
                {{ requisito.curso ? requisito.curso.nombre : 'Curso no asignado' }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="text-secondary fst-italic">No se han agregado requisitos a esta vacante.</p>
      {% endif %}
    </section>

    <!-- ⚙️ Acciones -->
    <div class="d-flex justify-content-end gap-2 mt-4">
      <a href="{{ path('app_vacantes_edit', {'id': vacante.id}) }}" class="btn btn-outline-info">
        <i class="bi bi-pencil-square me-1"></i> Editar
      </a>
      {{ include('admin/vacantes/_delete_form.html.twig') }}
    </div>
  </div>
</main>
{% endblock %}
