{% extends 'base.html.twig' %}

{% block title %}Editar Vacante{% endblock %}

{% block body %}
<style>
/* 🌌 Fondo oscuro total */
html,
body {
  background-color: #1e242b !important;
  color: #f1f3f5 !important;
  margin: 0;
  padding: 0;
  width: 100vw;
  min-height: 100vh;
}

/* 🔹 Contenedor principal */
main.container-fluid {
  width: 100vw !important;
  max-width: 100vw !important;
  padding: 2rem !important;
  background-color: #1e242b !important;
}

/* 💼 Card principal */
main.container-fluid .card {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 !important;
  border-radius: 1rem;
  border: 1px solid #3b4652;
  background-color: #2a323c !important;
  color: #f1f3f5 !important;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  padding: 2rem;
}

/* Inputs */
.info-input {
  background-color: #323a45 !important;
  border: 1px solid #495563 !important;
  color: #f1f3f5 !important;
  border-radius: 0.5rem;
}
.info-input:focus {
  border-color: #0dcaf0 !important;
  box-shadow: 0 0 0 0.2rem rgba(13, 202, 240, 0.25);
}

/* Botones */
.btn-guardar {
  background-color: #0dcaf0;
  color: #1e242b;
  border: none;
  border-radius: 0.5rem;
  padding: 0.6rem 1.4rem;
  font-weight: 500;
  transition: 0.3s;
}
.btn-guardar:hover {
  background-color: #09a6c9;
}

.btn-volver {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: transparent;
  color: #00e0c6;
  border: 1.5px solid #00e0c6;
  padding: 0.6rem 1.2rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease-in-out;
  box-shadow: 0 0 8px rgba(0, 255, 255, 0.2);
}
.btn-volver:hover {
  background: rgba(0, 255, 255, 0.1);
  box-shadow: 0 0 12px rgba(0, 255, 255, 0.5);
  transform: translateY(-2px);
}
.btn-volver i {
  font-size: 1.2rem;
}
</style>

<main class="container-fluid py-4">
  <div class="card shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-pencil-square text-info"></i> Editar Vacante</h1>
      <a href="{{ path('app_vacantes_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left-circle"></i> Volver a la lista
      </a>
    </div>

    {{ form_start(form, {'attr': {'class': 'vacante-form'}}) }}

    <section class="mb-4">
      <h4><i class="bi bi-info-circle"></i> Información de la vacante</h4>

      <div class="info-grid">
        <div>
          {{ form_label(form.nombre, 'Nombre de la vacante', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.nombre, {'attr': {'class': 'info-input'}}) }}
        </div>

        <div>
          {{ form_label(form.antiguedad, 'Antigüedad requerida (años)', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.antiguedad, {'attr': {'class': 'info-input'}}) }}
        </div>

        <div>
          {{ form_label(form.puesto, 'Puesto asociado', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.puesto, {'attr': {'class': 'info-input'}}) }}
        </div>

        <div>
          {{ form_label(form.categoria, 'Categoría', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.categoria, {'attr': {'class': 'info-input'}}) }}
        </div>
      </div>
    </section>

    <hr class="my-4">

    <section>
      <h4><i class="bi bi-list-check"></i> Requisitos</h4>

      <div data-prototype="{{ form_widget(form.requisitos.vars.prototype)|e('html_attr') }}"
           class="collection-requisitos requisitos-list mt-3">
        {% for requisito in form.requisitos %}
          <div class="requisito-item p-3 rounded shadow-sm mb-3" style="background-color:#2a323c;">
            <div class="d-flex align-items-center justify-content-between gap-3">
              <div class="flex-fill">
                {{ form_widget(requisito, {'attr': {'class': 'form-select requisito-curso'}}) }}
              </div>
              <button type="button" class="btn btn-outline-danger btn-sm remove-requisito">
                <i class="bi bi-trash"></i> Eliminar
              </button>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="actions mt-3">
        <button type="button" class="btn btn-outline-primary btn-add add-requisito">
          <i class="bi bi-plus-circle"></i> Agregar requisito
        </button>
      </div>
    </section>

    <div class="mt-4 text-end">
      <button class="btn-guardar">
        <i class="bi bi-save"></i> Actualizar vacante
      </button>
    </div>

    {{ form_end(form) }}
  </div>
</main>

{% block javascripts %}
  <script src="{{ asset('js/admin/vacantes/requisitos.js') }}"></script>
{% endblock %}
{% endblock %}
