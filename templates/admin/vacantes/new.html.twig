{% extends 'base.html.twig' %}

{% block title %}Nueva Vacante{% endblock %}

{% block body %}
<style>
label.required {
    color: #fff;
}
</style>
<main class="container-fluid py-4">
  <div class="card p-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-briefcase-fill text-info"></i> Crear Vacante</h1>
      <a href="{{ path('app_vacantes_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left-circle"></i> Volver a la lista
      </a>
    </div>

    {{ form_start(form, {'attr': {'class': 'vacante-form'}}) }}

    <section class="mb-4">
      <h4><i class="bi bi-info-circle"></i> Información de la vacante</h4>

      <div class="info-grid">
        <div>
          {{ form_label(form.nombre, 'Nombre de la vacante', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.nombre, {'attr': {'class': 'info-input'}}) }}
        </div>

        <div>
          {{ form_label(form.antiguedad, 'Antigüedad requerida (años)', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.antiguedad, {'attr': {'class': 'info-input'}}) }}
        </div>

        <div>
          {{ form_label(form.puesto, 'Puesto asociado', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.puesto, {'attr': {'class': 'info-input'}}) }}
        </div>

        <div>
          {{ form_label(form.categoria, 'Categoría', {'label_attr': {'class': 'data-label'}}) }}
          {{ form_widget(form.categoria, {'attr': {'class': 'info-input'}}) }}
        </div>
      </div>
    </section>

    <hr class="my-4">

    <section>
      <h4><i class="bi bi-list-check"></i> Requisitos</h4>

      <div data-prototype="{{ form_widget(form.requisitos.vars.prototype)|e('html_attr') }}" 
           class="collection-requisitos requisitos-list mt-3">
        {% for requisito in form.requisitos %}
          <div class="requisito-item p-3 rounded shadow-sm mb-3" style="background-color:#2a323c;">
            <div class="d-flex align-items-center justify-content-between gap-3">
              <div class="flex-fill">
                {{ form_widget(requisito, {'attr': {'class': 'form-select requisito-curso'}}) }}
              </div>
              <button type="button" class="btn btn-outline-danger btn-sm remove-requisito">
                <i class="bi bi-trash"></i> Eliminar
              </button>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="actions mt-3">
        <button type="button" class="btn btn-outline-primary btn-add add-requisito">
          <i class="bi bi-plus-circle"></i> Agregar requisito
        </button>
      </div>
    </section>

    <div class="mt-4 text-end">
      <button class="btn-guardar">
        <i class="bi bi-save"></i> Guardar vacante
      </button>
    </div>

    {{ form_end(form) }}
  </div>
</main>

{% block javascripts %}
  <script src="{{ asset('js/admin/vacantes/requisitos.js') }}"></script>
{% endblock %}
{% endblock %}
