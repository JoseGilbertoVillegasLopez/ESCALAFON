{% extends 'admin/layout.html.twig' %}
{% block title %}Lista de Cursos{% endblock %}
{% block admin_content %}




  <div class="card p-4 shadow-sm mx-auto">
    
    {# 🔹 ENCABEZADO #}
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-journal-bookmark-fill text-info"></i> Lista de Cursos</h1>
    </div>

    {# 🔍 FILTROS DE BÚSQUEDA #}
    <form method="get" class="mb-4">
      <div class="row g-3 align-items-end">
        <div class="col-md-5">
          <label for="nombre" class="data-label">Buscar por nombre</label>
          <input type="text" name="nombre" id="nombre" value="{{ app.request.get('nombre') }}" 
                 class="form-control info-input" placeholder="Ejemplo: Capacitación, Administración...">
        </div>

        <div class="col-md-4">
          <label for="categoria" class="data-label">Categoría</label>
          <select name="categoria" id="categoria" class="form-select info-input">
            <option value="">-- Todas --</option>
            {% for cat in categorias %}
              <option value="{{ cat.id }}" {% if app.request.get('categoria') == cat.id %}selected{% endif %}>
                {{ cat.nombre }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
          <button class="btn btn-outline-info flex-fill" type="submit">
            <i class="bi bi-search"></i> Buscar
          </button>
          <a href="{{ path('app_cursos_index') }}" class="btn btn-outline-warning flex-fill">
            <i class="bi bi-arrow-clockwise"></i> Limpiar
          </a>
        </div>
      </div>
    </form>

    {# 📋 TABLA DE CURSOS #}
    <div class="table-responsive mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <a href="{{ path('app_cursos_new') }}" class="btn-guardar d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i> Nuevo Curso
      </a>
    </div>

      <table class="table table-dark table-striped align-middle mb-0">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Valor</th>
            <th class="text-center" style="width: 150px;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for curso in cursos %}
            <tr>
              <td>{{ curso.nombre }}</td>
              <td>{{ curso.categoria.nombre }}</td>
              <td>{{ curso.valor }} pts</td>
              <td class="text-center">
                <a href="{{ path('app_cursos_show', {'id': curso.id}) }}" 
                   class="btn btn-outline-info btn-sm" title="Ver">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('app_cursos_edit', {'id': curso.id}) }}" 
                   class="btn btn-outline-warning btn-sm" title="Editar">
                  <i class="bi bi-pencil-square"></i>
                </a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="4" class="text-center text-muted py-3">
                <i class="bi bi-inbox"></i> No se encontraron cursos.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
