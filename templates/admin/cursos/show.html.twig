{% extends 'base.html.twig' %}

{% block title %}Detalle del Curso{% endblock %}

{% block body %}
<main class="container-fluid py-5" style="min-height: 100vh;">
  <div class="card p-4 shadow-sm mx-auto" style="max-width: 800px;">

    {# 🔹 Encabezado superior #}
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-book text-info"></i> Detalle del Curso</h1>
      <a href="{{ path('app_cursos_index') }}" class="btn-volver">
        <i class="bi bi-arrow-left-circle"></i> Volver a la lista
      </a>
    </div>

    {# 📘 Información general del curso #}
    <section class="mb-4">
      <h4><i class="bi bi-info-circle"></i> Información general</h4>
      <div class="mt-3 p-3 rounded" style="background-color: #323a45; border: 1px solid #3b4652;">
        <p><strong>📖 Nombre:</strong> {{ curso.nombre }}</p>
        <p><strong>🏷️ Categoría:</strong> {{ curso.categoria.nombre }}</p>
        <p><strong>⭐ Valor (puntos):</strong> {{ curso.valor }}</p>
      </div>
    </section>

    {# ⚙️ Acciones #}
    <div class="d-flex justify-content-end gap-2 mt-4">
      <a href="{{ path('app_cursos_edit', {'id': curso.id}) }}" class="btn btn-outline-warning">
        <i class="bi bi-pencil-square"></i> Editar
      </a>

      {{ include('admin/cursos/_delete_form.html.twig') }}
    </div>
  </div>
</main>
{% endblock %}
