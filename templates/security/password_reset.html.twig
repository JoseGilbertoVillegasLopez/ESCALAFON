{% extends 'base.html.twig' %}

{% block title %}Restablecer contraseña{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/login/login.css') }}">
{% endblock %}

{% block body %}
{{ include('backgraunds/burbujas.html.twig') }}

<div class="login-wrapper">
  <div class="login-card">
    <img src="{{ asset('uploads/imagenes/login_logo.png') }}" alt="Logo Sindicato" class="login-logo">
    <h1 class="login-title">Sindicato Independiente</h1>
    <p class="login-subtitle">Restablecer contraseña</p>

   {% for msg in app.flashes('mensaje') %}
  <div class="alert alert-success" id="successMsg">{{ msg }}</div>
{% endfor %}

{% for err in app.flashes('error') %}
  <div class="alert alert-danger">{{ err }}</div>
{% endfor %}

    <form method="post" id="resetForm">
  <div class="form-group">
    <i class="bi bi-envelope"></i>
    <input type="email" name="correo" id="correo"
           placeholder="Nombre de usuario, ejp: pepito@gamil.com"
           value="{{ correo }}" required autofocus>
  </div>

  <div class="form-group password-group">
    <i class="bi bi-lock"></i>
    <input type="password" name="password" id="password"
           placeholder="Nueva contraseña" required>
    <i class="bi bi-eye toggle-password" id="togglePassword"></i>
  </div>

  <div class="form-group password-group">
    <i class="bi bi-lock"></i>
    <input type="password" name="password_confirm" id="password_confirm"
           placeholder="Confirmar nueva contraseña" required>
    <i class="bi bi-eye toggle-password" id="togglePassword2"></i>
  </div>

  <button type="submit" class="btn-login">Actualizar contraseña</button>

  <div class="register-link">
    <a href="{{ path('app_login') }}" class="back-link">Volver al inicio de sesión</a>
  </div>
</form>






  </div>
</div>


{% endblock %}


{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const successMsg = document.getElementById('successMsg');
  const form = document.getElementById('resetForm');

  if (successMsg) {
    // Oculta inicialmente
    successMsg.style.opacity = 0;
    successMsg.style.transition = 'opacity 0.8s ease';

    // Fade in
    setTimeout(() => {
      successMsg.style.opacity = 1;
    }, 100);

    // Limpia el formulario después de 1 segundo
    setTimeout(() => {
      if (form) form.reset();
    }, 1000);

    // Desvanece el mensaje después de 5 segundos
    setTimeout(() => {
      successMsg.style.opacity = 0;
    }, 5000);
  }
});
</script>
{% endblock %}