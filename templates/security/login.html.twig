{% extends 'base.html.twig' %}
{% block stylesheets %}
<link rel="stylesheet" href="{{asset('css/login/login.css')}}">
{% endblock %}
{% block title %}Iniciar sesión{% endblock %}

{% block body %}
{{include('backgraunds/burbujas.html.twig')}}

<div class="login-container">
    <i class="bi bi-person-circle login-icon"></i>
    <img src="{{asset('imagenes/login_logo.png')}}" alt="Logo" class="login-logo"/>

    {% if error %}
        <div class="alert alert-danger">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post">
        <div class="form-group">
            <i class="bi bi-person"></i>
            <input type="text" value="{{ last_username }}" name="_username" id="username"
                   placeholder="Username" required autofocus autocomplete="username">
        </div>

        <div class="form-group">
            <i class="bi bi-lock"></i>
            <input type="password" name="_password" id="password" 
            placeholder="Password" required autocomplete="current-password">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <a href="#" class="forgot-password">¿Olvidaste tu contraseña?</a>

        <button class="btn-login" type="submit">Login</button>
    </form>
</div>
{{include('backgraunds/burbujas.html.twig')}}

{% endblock %}
