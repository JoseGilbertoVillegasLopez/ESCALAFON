{% extends 'user/layout.html.twig' %}
{% block title %}Mi Escalafón{% endblock %}

{% block user_content %}
<style>
/* 🌙 Fondo y tipografía */
html, body {
    background-color: #1e242b !important;
    color: #f1f3f5 !important;
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
}

main.container-fluid {
    width: 100%;
    max-width: 100%;
    padding: 2rem;
}

/* 💼 Card principal */
.card {
    background-color: #2a3038;
    border: 1px solid #3c444f;
    border-radius: 1rem;
    box-shadow: 0 0 15px rgba(0,0,0,0.2);
    color: #f8f9fa;
    overflow: hidden;
}

/* 🧾 Título */
h1 {
    text-align: center;
    margin-bottom: 1.5rem;
    font-weight: 600;
}

/* 📊 Tabla */
table {
    width: 100%;
    border-collapse: collapse;
    color: #f1f3f5;
}

th, td {
    padding: 0.75rem 1rem;
    text-align: left;
}

th {
    background-color: #343b45;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
}

tr:nth-child(even) {
    background-color: #2f353e;
}

/* 🧭 Botones */
.btn {
    border-radius: 0.5rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    transition: all 0.2s ease-in-out;
}

.btn-volver {
    background-color: #49515d;
    color: #fff;
}

.btn-volver:hover {
    background-color: #5a6371;
}

.btn-notificar {
    background-color: #007bff;
    color: #fff;
}

.btn-notificar:hover {
    background-color: #0069d9;
}

/* 📱 Responsive */
@media (max-width: 768px) {
    table thead {
        display: none;
    }
    table, table tbody, table tr, table td {
        display: block;
        width: 100%;
    }
    table tr {
        margin-bottom: 1rem;
        background: #2f353e;
        border-radius: 0.5rem;
        padding: 0.75rem;
    }
    table td {
        text-align: right;
        padding-left: 50%;
        position: relative;
    }
    table td::before {
        content: attr(data-label);
        position: absolute;
        left: 0;
        width: 50%;
        padding-left: 1rem;
        font-weight: bold;
        text-align: left;
        color: #adb5bd;
    }

}
</style>
<div class="card p-4 shadow-lg">
  <h2 class="text-center text-info mb-3" style="font-size: 2rem;">
    <i class="bi bi-bar-chart-steps"></i> Escalafón de la categoría: {{ categoria.nombre }}
  </h2>

  {% if posicion %}
    <p class="text-center text-secondary">
      Tu posición actual: <strong class="text-warning">#{{ posicion }}</strong>
    </p>
  {% endif %}

  {% if items is empty %}
    <div class="alert alert-secondary text-center mt-4">
      <i class="bi bi-info-circle"></i> No hay registros en tu categoría.
    </div>
  {% else %}
    <div class="table-responsive mt-4">
      <table class="table table-dark table-striped align-middle">
        <thead>
          <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Puesto</th>
            <th>Antigüedad</th>
            <th>Capacitación</th>
            <th>Sanciones</th>
            <th>Puntaje Total</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for t in items %}
            <tr class="{% if t.id == mi_id %}table-primary{% endif %}">
              <td>{{ loop.index }}</td>
              <td>
                {% if t.id == mi_id %}
                  <strong>{{ t.nombre }} (Tú)</strong>
                {% else %}
                  {{ t.nombre }}
                {% endif %}
              </td>
              <td>{{ t.puesto }}</td>
              <td>{{ t.antiguedad }}</td>
              <td>{{ t.puntos_capacitacion }}</td>
              <td>{{ t.puntos_sancion }}</td>
              <td>
                <strong style="color: {{ t.puntaje_total > 0 ? '#00e676' : '#ff5252' }}">
                  {{ t.puntaje_total }}
                </strong>
              </td>
              <td class="text-center">
                {% if t.id == mi_id %}
                  <a href="{{ path('usuario_escalafon_show', { id: t.id }) }}"
                     class="btn btn-outline-info btn-sm d-flex align-items-center gap-1 justify-content-center">
                    <i class="bi bi-eye"></i> Ver
                  </a>
                {% else %}
                  <span class="text-muted small">—</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>

<style>
.table-primary {
  background-color: rgba(13,202,240,0.2) !important;
  border-left: 4px solid #0dcaf0;
}
</style>
{% endblock %}






