{% extends 'user/layout.html.twig' %}

{% block title %}Mi Información Personal{% endblock %}

{% block user_content %}

<div class="card p-4 shadow-sm mx-auto" style="background:#1e242b; border:1px solid #2d333b; color:#e9edf1;">
  
  {# 🔙 Volver al Dashboard #}
  <div class="mb-3 d-flex justify-content-between align-items-center">

    <a href="{{ path('usuario_informacion_personal_edit', {'id': informacion_personal.id}) }}"
       class="btn btn-outline-warning btn-sm d-flex align-items-center gap-2">
      <i class="bi bi-pencil-square"></i> Editar información
    </a>
  </div>

  {# =========================
     🧍 PERFIL / IMAGEN
     ========================= #}
  <section class="text-center mb-5">
    <div class="perfil-container">
      <h3 class="text-info mb-3">
        <i class="bi bi-person-circle"></i>
        {{ informacion_personal.nombre }} {{ informacion_personal.apellidoPaterno }} {{ informacion_personal.apellidoMaterno }}
      </h3>

      <div class="perfil-imagen mb-3">
        {% if informacion_personal.imagen %}
          <img src="{{ asset('uploads/imagenes/' ~ informacion_personal.imagen) }}"
               alt="Foto de perfil"
               class="img-preview"
               style="width:140px; height:140px; border-radius:50%; object-fit:cover; border:2px solid #2d333b;">
        {% else %}
          <img src="{{ asset('uploads/imagenes/login_logo.png') }}"
               alt="Sin foto"
               style="width:140px; height:140px; border-radius:50%; opacity:0.7;">
        {% endif %}
      </div>
    </div>
  </section>

  {# =========================
     💍 DATOS PERSONALES
     ========================= #}
  <section class="mb-5">
    <h4><i class="bi bi-person-badge"></i> Datos personales</h4>
    <div class="row g-3 mt-3">
      <div class="col-md-4">
        <span class="data-label">Nombre(s)</span>
        <div class="info-field">{{ informacion_personal.nombre }}</div>
      </div>
      <div class="col-md-4">
        <span class="data-label">Apellido paterno</span>
        <div class="info-field">{{ informacion_personal.apellidoPaterno }}</div>
      </div>
      <div class="col-md-4">
        <span class="data-label">Apellido materno</span>
        <div class="info-field">{{ informacion_personal.apellidoMaterno }}</div>
      </div>
      <div class="col-md-4">
        <span class="data-label">Estado civil</span>
        <div class="info-field">
        {% if informacion_personal.estadoCivil %}
          Soltero(a)
        {% else %}
          Casado(a)
        {% endif %}
      </div>
      </div>
    </div>
  </section>

  {# =========================
     📞 CONTACTO
     ========================= #}
  <section class="mb-5">
    <h4><i class="bi bi-telephone-fill"></i> Información de contacto</h4>
    <div class="row g-3 mt-3">
      <div class="col-md-4">
        <span class="data-label">Teléfono fijo</span>
        <div class="info-field">{{ informacion_personal.telefonoFijo ?? '—' }}</div>
      </div>
      <div class="col-md-4">
        <span class="data-label">Teléfono celular</span>
        <div class="info-field">{{ informacion_personal.telefonoCelular ?? '—' }}</div>
      </div>
      <div class="col-md-4">
        <span class="data-label">Correo</span>
        <div class="info-field">{{ informacion_personal.correo ?? '—' }}</div>
      </div>
      <div class="col-md-12">
        <span class="data-label">Domicilio</span>
        <div class="info-field">{{ informacion_personal.domicilio ?? '—' }}</div>
      </div>
    </div>
  </section>

  {# =========================
     🚨 CONTACTOS DE EMERGENCIA
     ========================= #}
  <section class="mb-4">
    <h4><i class="bi bi-people-fill text-warning"></i> Contactos de emergencia</h4>

    {% if informacion_personal.contactosEmergencias is defined and informacion_personal.contactosEmergencias|length > 0 %}
      <div class="mt-3">
        {% for contacto in informacion_personal.contactosEmergencias %}
          <div class="p-3 mb-3 rounded" style="background:#262d36;">
            <div class="row g-3">
              <div class="col-md-3">
                <span class="data-label">Nombre</span>
                <div class="info-field">{{ contacto.nombre ?? '—' }}</div>
              </div>
              <div class="col-md-3">
                <span class="data-label">Parentesco</span>
                <div class="info-field">{{ contacto.parentesco ?? '—' }}</div>
              </div>
              <div class="col-md-3">
                <span class="data-label">Teléfono</span>
                <div class="info-field">{{ contacto.telefono ?? '—' }}</div>
              </div>
              <div class="col-md-3">
                <span class="data-label">Correo</span>
                <div class="info-field">{{ contacto.correo ?? '—' }}</div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="text-muted fst-italic mt-2">No tienes contactos de emergencia registrados.</p>
    {% endif %}
  </section>
</div>

{% endblock %}
