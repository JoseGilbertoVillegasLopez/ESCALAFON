{% extends 'user/layout.html.twig' %}

{% block title %}Editar mi información personal{% endblock %}

{% block user_content %}

<div class="card p-4 shadow-sm mx-auto" style=" background:#1e242b; border:1px solid #2d333b; color:#e9edf1;">
  
  {# 🔙 Volver #}
  <div class="mb-3 d-flex justify-content-between align-items-center">
    <a href="{{ path('usuario_informacion_personal_show', {'id': informacion_personal.id}) }}" class="btn-volver">
      <i class="bi bi-arrow-left-circle"></i> Volver
    </a>
    <h3 class="text-info m-0"><i class="bi bi-pencil-square"></i> Editar mi información</h3>
  </div>

  {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

  {# =========================
     🧍 IMAGEN DE PERFIL
     ========================= #}
  <section class="text-center mb-5">
    <div class="perfil-container">

      <h4 class="mb-3 text-light">Foto de perfil</h4>

      <div class="perfil-imagen mt-2 mb-3">
        {% if informacion_personal.imagen %}
          <img id="preview" src="{{ asset('uploads/imagenes/' ~ informacion_personal.imagen) }}"
               alt="Foto actual" class="img-preview"
               style="width:140px; height:140px; border-radius:50%; object-fit:cover; border:2px solid #2d333b;">
        {% else %}
          <img id="preview" src="{{ asset('uploads/imagenes/login_logo.png') }}"
               alt="Sin imagen" class="img-preview"
               style="width:140px; height:140px; border-radius:50%; object-fit:cover; opacity:0.7;">
        {% endif %}
      </div>

      <div class="col-md-6 mx-auto">
        {{ form_label(form.imagen, 'Actualizar imagen', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.imagen, {
          'attr': {
        'onchange': 'previewImage(event)',
        'accept': 'image/*',
        'class': 'form-control bg-dark text-light border-secondary'
          }
        }) }}
        {{ form_errors(form.imagen) }}
      </div>
    </div>
  </section>

  {# =========================
     💍 ESTADO CIVIL
     ========================= #}
  <section class="mb-5">
    <h4><i class="bi bi-heart-fill text-danger"></i> Estado civil</h4>
    <div class="mt-3">
      {{ form_widget(form.estadoCivil, {'attr': {'class': 'form-select info-input'}}) }}
      {{ form_errors(form.estadoCivil) }}
    </div>
  </section>

  {# =========================
     📞 INFORMACIÓN DE CONTACTO
     ========================= #}
  <section class="mb-5">
    <h4><i class="bi bi-telephone-fill text-info"></i> Información de contacto</h4>
    <div class="row g-3 mt-3">
      <div class="col-md-6">
        {{ form_label(form.telefonoFijo, 'Teléfono fijo', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.telefonoFijo, {'attr': {'class': 'form-control info-input'}}) }}
      </div>
      <div class="col-md-6">
        {{ form_label(form.telefonoCelular, 'Teléfono celular', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.telefonoCelular, {'attr': {'class': 'form-control info-input'}}) }}
      </div>
      <div class="col-md-6">
        {{ form_label(form.correo, 'Correo electrónico', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.correo, {'attr': {'class': 'form-control info-input'}}) }}
      </div>
      <div class="col-md-6">
        {{ form_label(form.domicilio, 'Domicilio', {'label_attr': {'class': 'data-label'}}) }}
        {{ form_widget(form.domicilio, {'attr': {'class': 'form-control info-input'}}) }}
      </div>
    </div>
  </section>

  {# =========================
     🚨 CONTACTOS DE EMERGENCIA
     ========================= #}
  <section class="mb-5">
    <h4><i class="bi bi-people-fill text-warning"></i> Contactos de emergencia</h4>

    <div class="collection-contactos mt-3"
         data-prototype="
          <div class='contacto-item mb-3 p-3 rounded' style='background:#262d36;'>
            <div class='row g-3'>
              <div class='col-md-3'>{{ form_widget(form.contactosEmergencias.vars.prototype.nombre)|e('html_attr') }}</div>
              <div class='col-md-3'>{{ form_widget(form.contactosEmergencias.vars.prototype.parentesco)|e('html_attr') }}</div>
              <div class='col-md-3'>{{ form_widget(form.contactosEmergencias.vars.prototype.telefono)|e('html_attr') }}</div>
              <div class='col-md-3'>{{ form_widget(form.contactosEmergencias.vars.prototype.correo)|e('html_attr') }}</div>
            </div>
          </div>
        ">
      {% for item in form.contactosEmergencias %}
        <div class="contacto-item mb-3 p-3 rounded" style="background:#262d36;">
          <div class="row g-3">
            <div class="col-md-3">{{ form_widget(item.nombre, {'attr': {'class': 'form-control'}}) }}</div>
            <div class="col-md-3">{{ form_widget(item.parentesco, {'attr': {'class': 'form-control'}}) }}</div>
            <div class="col-md-3">{{ form_widget(item.telefono, {'attr': {'class': 'form-control'}}) }}</div>
            <div class="col-md-3">{{ form_widget(item.correo, {'attr': {'class': 'form-control'}}) }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  {# =========================
     💾 BOTÓN GUARDAR
     ========================= #}
  <div class="text-center mt-4">
    <button type="submit" class="btn-guardar d-flex align-items-center justify-content-center gap-2 mx-auto">
      <i class="bi bi-save"></i> Guardar cambios
    </button>
  </div>

  {{ form_end(form) }}

</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
  <script src="{{ asset('js/user/informacionPersonal/preview.js') }}"></script>
  <script src="{{ asset('js/user/informacionPersonal/collection.js') }}"></script>
{% endblock %}
